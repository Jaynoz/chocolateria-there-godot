; Engine configuration file.
; Gerado pra você — abra esta pasta direto no Godot 4.x com "Import".

config_version=5

[application]

config/name="Chocolateria Therê"
config/version="1.0"
run/main_scene="res://scenes/Main.tscn"
; Precisa bater com a versão usada no CI (codemagic.yaml baixa a 4.7.1).
; Estava marcado "4.2" enquanto o export_presets.cfg já usava chaves que só
; existem da 4.5 em diante — o editor abria reclamando de incompatibilidade.
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/logos/logo_game.png"
boot_splash/bg_color=Color(0.576471, 0.07451, 0.294118, 1)
boot_splash/image="res://assets/logos/logo_game.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

ItemData="*res://scripts/autoload/ItemData.gd"
GameState="*res://scripts/autoload/GameState.gd"
SoundManager="*res://scripts/autoload/SoundManager.gd"
SDK="*res://scripts/autoload/SDK.gd"

[display]

window/size/viewport_width=420
window/size/viewport_height=900
window/stretch/mode="canvas_items"
; "expand" em vez do padrão "keep": em vez de deixar tarja preta nas bordas,
; a UI ganha o espaço extra. É o que faz o mesmo layout servir do iPhone SE
; ao iPad e à janela do Google Play Games para PC.
window/stretch/aspect="expand"
window/handheld/orientation="portrait"
window/size/resizable=true

[input_devices]

; Play Games para PC e Chromebook entregam mouse, não dedo. Sem isso, um
; clique não vira evento de toque e parte da UI fica sem resposta nessas
; plataformas.
pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Filtro linear: as imagens dos itens têm 256px e são desenhadas a ~70px.
; Sem filtro elas ficam serrilhadas em tela de alta densidade.
textures/canvas_textures/default_texture_filter=1

[internationalization]

locale/fallback="en"
; Sem esta lista, os arquivos de tradução nunca são carregados e todo
; tr() do jogo devolve o texto original em português — a localização
; inteira ficava inerte, mesmo com o CSV pronto no projeto.
locale/translations=PackedStringArray("res://localization/translations.pt_BR.translation", "res://localization/translations.en.translation", "res://localization/translations.es.translation", "res://localization/translations.fr.translation", "res://localization/translations.de.translation", "res://localization/translations.it.translation", "res://localization/translations.nl.translation")
